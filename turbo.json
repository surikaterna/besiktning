{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "compile": {
      "outputs": ["lib/**"]
    },
    "besiktning-noderuntime#compile": {
      "dependsOn": ["besiktning#compile"],
      "outputs": ["lib/**"]
    },
    "test:unit": {
      "dependsOn": ["compile"],
      "outputs": []
    },
    "test:artifact": {
      "dependsOn": ["compile"],
      "cache": false,
      "outputs": []
    },
    "test.watch": {
      "persistent": true,
      "cache": false
    },
    "compile.watch": {
      "persistent": true,
      "cache": false
    }
  }
}
